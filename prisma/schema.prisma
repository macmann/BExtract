generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

generator pyclient {
  provider        = "prisma-client-py"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum PipelineExecutionStatus {
  processing
  success
  failed
}

model DocumentTemplate {
  id          String             @id @default(cuid())
  name        String
  description String?
  config      Json
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  results     ExtractionResult[]
}

model ExtractionResult {
  id          String           @id @default(cuid())
  documentId  String
  fileName    String
  rawText     String?
  data        Json
  confidence  Float?
  status      String           @default("pending")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  templateId  String?
  template    DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  chunks      DocumentChunk[]
}

model DocumentChunk {
  id            String           @id @default(uuid())
  extraction_id String
  chunk_text    String
  embedding     Unsupported("vector(3072)")
  metadata      Json?
  extraction    ExtractionResult @relation(fields: [extraction_id], references: [id], onDelete: Cascade)
}

model PipelineRun {
  id                String                  @id @default(uuid()) @db.Uuid
  templateId        String?                 @map("template_id")
  status            PipelineExecutionStatus @default(processing)
  startedAt         DateTime                @default(now()) @map("started_at")
  completedAt       DateTime?               @map("completed_at")
  totalFiles        Int                     @map("total_files")
  processedFiles    Int                     @default(0) @map("processed_files")
  totalInputTokens  Int                     @default(0) @map("total_input_tokens")
  totalOutputTokens Int                     @default(0) @map("total_output_tokens")
  totalCostUsd      Float                   @default(0.0) @map("total_cost_usd")
  fileExtractions   FileExtraction[]

  @@index([templateId])
  @@index([status])
  @@map("pipeline_runs")
}

model FileExtraction {
  id               String                  @id @default(uuid()) @db.Uuid
  runId            String                  @map("run_id") @db.Uuid
  fileName         String                  @map("file_name")
  status           PipelineExecutionStatus @default(processing)
  extractedPayload Json                    @default("{}") @map("extracted_payload")
  logs             String                  @default("") @db.Text
  errorMessage     String?                 @map("error_message") @db.Text
  sourceFilePath   String?                 @map("source_file_path") @db.Text
  run              PipelineRun             @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([status])
  @@map("file_extractions")
}
